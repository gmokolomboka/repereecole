generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools   School[]
  users     User[]
  roles     Role[]
  tasks     Task[]
  events    Event[]

  @@index([status])
}

model School {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String?
  address   String?
  city      String?
  phone     String?
  email     String?
  timezone  String   @default("Europe/Paris")
  status    String   @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  classes   Class[]
  students  Student[]
  tasks     Task[]
  events    Event[]
  attendance Attendance[]

  @@index([tenantId])
  @@index([status])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  externalId   String?
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  status       String   @default("ACTIVE")
  lastLoginAt  DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  roles        UserRole[]
  tasks        Task[] @relation("TaskCreatedBy")
  assignedTasks Task[] @relation("TaskAssignedTo")
  events       Event[]
  eventParticipants EventParticipant[]
  staffAssignments StaffAssignment[]

  @@index([tenantId])
  @@index([email])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?

  createdAt   DateTime @default(now())

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  schoolId  String?

  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, schoolId])
  @@index([userId])
}

model Class {
  id            String   @id @default(cuid())
  schoolId      String
  name          String
  level         String
  academicYear  String

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school        School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  students      StudentClass[]
  staffAssignments StaffAssignment[]

  @@index([schoolId])
}

model Student {
  id           String   @id @default(cuid())
  schoolId     String
  studentNumber String
  firstName    String
  lastName     String
  birthDate    DateTime?
  gender       String?
  status       String   @default("ACTIVE")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school       School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classes      StudentClass[]
  guardians    StudentGuardian[]
  attendance   Attendance[]

  @@index([schoolId])
  @@index([schoolId, lastName])
}

model StudentClass {
  id        String   @id @default(cuid())
  studentId String
  classId   String
  startDate DateTime
  endDate   DateTime?

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([classId])
}

model LegalGuardian {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  address   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students  StudentGuardian[]

  @@index([email])
}

model StudentGuardian {
  id                     String   @id @default(cuid())
  studentId              String
  guardianId             String
  relationship           String
  isPrimary              Boolean  @default(false)
  hasPickupAuthorization Boolean  @default(false)

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian  LegalGuardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([studentId])
}

model StaffAssignment {
  id        String   @id @default(cuid())
  userId    String
  schoolId  String
  classId   String?
  role      String
  startDate DateTime
  endDate   DateTime?

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class     Class? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([schoolId])
}

model Task {
  id          String   @id @default(cuid())
  tenantId    String
  schoolId    String
  createdById String
  assignedToId String?

  title       String
  description String?
  priority    String   @default("NORMAL")
  status      String   @default("TODO")
  dueAt       DateTime?
  completedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school      School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy   User @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignedTo  User? @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([assignedToId, status])
  @@index([schoolId, dueAt])
  @@index([tenantId])
}

model Event {
  id        String   @id @default(cuid())
  tenantId  String
  schoolId  String
  createdById String

  title     String
  description String?
  type      String   @default("OTHER")
  status    String   @default("PLANNED")
  startsAt  DateTime
  endsAt    DateTime?
  location  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  participants EventParticipant[]

  @@index([schoolId, startsAt])
  @@index([tenantId])
}

model EventParticipant {
  id      String   @id @default(cuid())
  eventId String
  userId  String
  status  String   @default("INVITED")

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model Attendance {
  id                  String   @id @default(cuid())
  schoolId            String
  studentId           String
  date                DateTime
  status              String   @default("UNKNOWN")
  arrivalTime         DateTime?
  departureTime       DateTime?
  reason              String?
  justificationStatus String?
  comment             String?
  recordedById        String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  school              School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student             Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([schoolId, date])
  @@index([studentId, date])
}
